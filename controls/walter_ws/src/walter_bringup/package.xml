<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>walter_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and controller configuration for the Walter cell (mock, Isaac Sim, or ABB IRB 120).</description>
  <maintainer email="noreply@example.com">Walter C. Lamp team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>walter_description</exec_depend>
  <exec_depend>walter_moveit_config</exec_depend>
  <exec_depend>walter_control</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>moveit_servo</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
