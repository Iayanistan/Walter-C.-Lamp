<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>walter_description</name>
  <version>0.1.0</version>
  <description>URDF/xacro for the Walter C. Lamp cell: ABB IRB 120 (stand-in arm), lab bench, tool and camera frames, and the ros2_control block for mock, Isaac Sim and real ABB hardware.</description>
  <maintainer email="noreply@example.com">Walter C. Lamp team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- Pulled in only when hardware:=isaac / hardware:=abb -->
  <exec_depend>topic_based_ros2_control</exec_depend>
  <!-- abb_hardware_interface is built from source (see walter.repos); not listed so mock/isaac builds don't need it -->

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
