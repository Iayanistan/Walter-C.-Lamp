<?xml version="1.0"?>
<!-- FAIRINO FR3 (v6) kinematics and inertials, transcribed from fairino_description/urdf/fairino3_v6.urdf
     (FAIR-INNOVATION/frcobot_ros2). Links and joints are renamed to the Walter convention
     (base_link, link_1..link_6, joint_1..joint_6, tool0) so nothing above the description changes.
     Meshes are NOT copied: they load from the fairino_description package, which must be in the
     workspace (see the FR3 tutorial). Regenerate with scripts/gen_fr3.py if Fairino updates the URDF. -->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="fairino_fr3" params="prefix">
    <link name="${prefix}base_link">
      <inertial><origin xyz="-0.00049027 -0.00045095 0.032527" rpy="0 0 0"/><mass value="0.78393"/><inertia ixx="0.0013854" ixy="1.1455E-05" ixz="-1.0642E-05" iyy="0.0013849" iyz="-9.7435E-06" izz="0.001977"/></inertial>
      <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://fairino_description/meshes/fairino3_v6/base_link.STL"/></geometry><material name="fairino_white"><color rgba="0.898 0.918 0.929 1"/></material></visual>
      <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://fairino_description/meshes/fairino3_v6/base_link.STL"/></geometry></collision>
    </link>
    <link name="${prefix}link_1">
      <inertial><origin xyz="-0.00005 -0.01592 0.00226" rpy="0 0 0"/><mass value="2.24"/><inertia ixx="0.00303904" ixy="-0.00000346" ixz="-0.00001029" iyy="0.00223536" iyz="0.00008620" izz="0.00296223"/></inertial>
      <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://fairino_description/meshes/fairino3_v6/shoulder_link.STL"/></geometry><material name="fairino_white"><color rgba="0.898 0.918 0.929 1"/></material></visual>
      <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://fairino_description/meshes/fairino3_v6/shoulder_link.STL"/></geometry></collision>
    </link>
    <link name="${prefix}link_2">
      <inertial><origin xyz="0.13939 0.0 0.09954" rpy="0 0 0"/><mass value="4.94"/><inertia ixx="0.0068126" ixy="0.00000606" ixz="-0.00003661" iyy="0.09321437" iyz="0.00000024" izz="0.09150689"/></inertial>
      <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://fairino_description/meshes/fairino3_v6/upperarm_link.STL"/></geometry><material name="fairino_white"><color rgba="0.898 0.918 0.929 1"/></material></visual>
      <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://fairino_description/meshes/fairino3_v6/upperarm_link.STL"/></geometry></collision>
    </link>
    <link name="${prefix}link_3">
      <inertial><origin xyz="0.05899 0.00008 0.01299" rpy="0 0 0"/><mass value="2.29"/><inertia ixx="0.00263873" ixy="0.00002077" ixz="-0.00014132" iyy="0.02074603" iyz="-0.00000186" izz="0.02039086"/></inertial>
      <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://fairino_description/meshes/fairino3_v6/forearm_link.STL"/></geometry><material name="fairino_white"><color rgba="0.898 0.918 0.929 1"/></material></visual>
      <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://fairino_description/meshes/fairino3_v6/forearm_link.STL"/></geometry></collision>
    </link>
    <link name="${prefix}link_4">
      <inertial><origin xyz="0.00005 -0.00233 0.01467" rpy="0 0 0"/><mass value="1.56"/><inertia ixx="0.00162646" ixy="-0.00000285" ixz="-0.00000348" iyy="0.00158068" iyz="0.00006122" izz="0.00125531"/></inertial>
      <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://fairino_description/meshes/fairino3_v6/wrist1_link.STL"/></geometry><material name="fairino_white"><color rgba="0.898 0.918 0.929 1"/></material></visual>
      <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://fairino_description/meshes/fairino3_v6/wrist1_link.STL"/></geometry></collision>
    </link>
    <link name="${prefix}link_5">
      <inertial><origin xyz="-0.00005 0.00233 0.01467" rpy="0 0 0"/><mass value="1.56"/><inertia ixx="0.00162646" ixy="-0.00000285" ixz="0.00000348" iyy="0.00158068" iyz="-0.00006122" izz="0.00125531"/></inertial>
      <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://fairino_description/meshes/fairino3_v6/wrist2_link.STL"/></geometry><material name="fairino_white"><color rgba="0.898 0.918 0.929 1"/></material></visual>
      <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://fairino_description/meshes/fairino3_v6/wrist2_link.STL"/></geometry></collision>
    </link>
    <link name="${prefix}link_6">
      <inertial><origin xyz="-0.00055 -0.00111 -0.02005" rpy="0 0 0"/><mass value="0.36"/><inertia ixx="0.00023024" ixy="0.00000023" ixz="-0.00000058" iyy="0.00023033" iyz="-0.00000116" izz="0.00035930"/></inertial>
      <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://fairino_description/meshes/fairino3_v6/wrist3_link.STL"/></geometry><material name="fairino_white"><color rgba="0.898 0.918 0.929 1"/></material></visual>
      <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://fairino_description/meshes/fairino3_v6/wrist3_link.STL"/></geometry></collision>
    </link>
    <joint name="${prefix}joint_1" type="revolute">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${prefix}base_link"/>
      <child link="${prefix}link_1"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.0543" upper="3.0543" effort="150" velocity="3.15"/>
    </joint>
    <joint name="${prefix}joint_2" type="revolute">
      <origin xyz="0 0 0.14" rpy="1.5708 0 0"/>
      <parent link="${prefix}link_1"/>
      <child link="${prefix}link_2"/>
      <axis xyz="0 0 1"/>
      <limit lower="-4.6251" upper="1.4835" effort="150" velocity="3.15"/>
    </joint>
    <joint name="${prefix}joint_3" type="revolute">
      <origin xyz="-0.28 0 0" rpy="0 0 0"/>
      <parent link="${prefix}link_2"/>
      <child link="${prefix}link_3"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.8274" upper="2.8274" effort="150" velocity="3.15"/>
    </joint>
    <joint name="${prefix}joint_4" type="revolute">
      <origin xyz="-0.24001 0 0" rpy="0 0 0"/>
      <parent link="${prefix}link_3"/>
      <child link="${prefix}link_4"/>
      <axis xyz="0 0 1"/>
      <limit lower="-4.6251" upper="1.4835" effort="28" velocity="3.2"/>
    </joint>
    <joint name="${prefix}joint_5" type="revolute">
      <origin xyz="0 0 0.102" rpy="1.5708 0 0"/>
      <parent link="${prefix}link_4"/>
      <child link="${prefix}link_5"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.0543" upper="3.0543" effort="28" velocity="3.2"/>
    </joint>
    <joint name="${prefix}joint_6" type="revolute">
      <origin xyz="0 0 0.102" rpy="-1.5708 0 0"/>
      <parent link="${prefix}link_5"/>
      <child link="${prefix}link_6"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.0543" upper="3.0543" effort="28" velocity="3.2"/>
    </joint>
    <!-- tool0 = the flange face (wrist3 frame, z out of the flange). Check it against the TCP
         pose the FAIRINO WebApp reports with the tool set to 0 before trusting it. -->
    <link name="${prefix}tool0"/>
    <joint name="${prefix}link_6-tool0" type="fixed">
      <parent link="${prefix}link_6"/>
      <child link="${prefix}tool0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>
