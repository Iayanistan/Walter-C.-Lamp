# Source dependencies that are not in the ROS 2 Jazzy apt repos. Only needed for hardware:=abb.
#   cd ~/walter_ws/src && vcs import < ../walter.repos
repositories:
  abb_ros2:
    type: git
    url: https://github.com/PickNikRobotics/abb_ros2.git
    version: rolling
  abb_libegm:
    type: git
    url: https://github.com/ros-industrial/abb_libegm.git
    version: master
  abb_librws:
    type: git
    url: https://github.com/ros-industrial/abb_librws.git
    version: master
  abb_egm_rws_managers:
    type: git
    url: https://github.com/ros-industrial/abb_egm_rws_managers.git
    version: master
  abb_ros2_msgs:
    type: git
    url: https://github.com/gbartyzel/abb_ros2_msgs.git
    version: rolling
