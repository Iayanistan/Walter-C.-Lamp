<?xml version="1.0" encoding="utf-8"?>
<!-- Fairino FR3 WMS (official fairino_description FR3WMS.urdf) + AG-105-145 gripper
     Gripper: DH-Robotics AG-105-145, built from the SolidWorks assembly AG-105-145-W-S_DH-Robotics
     (per-part STL export, pivot axes fitted from the CAD geometry).
     Actuated joint: finger_joint, 0 = fully open (145 mm), 0.932 rad = fingertips touching.
     All other gripper joints are <mimic> joints of finger_joint. The adaptive drive linkage
     (slider, G links, drive cranks, adaptive links) is a closed loop, approximated with linear
     mimic ratios (max error ~0.06 rad on the short G links, under 0.01 rad elsewhere). -->
<robot name="fr3wms_ag145">
  <link
    name="base_link">
    <inertial>
      <origin
        xyz="0.00049216 0.00040932 0.032944"
        rpy="0 0 0" />
