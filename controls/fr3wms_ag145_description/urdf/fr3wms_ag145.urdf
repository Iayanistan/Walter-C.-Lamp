  <!-- tool_Link is referenced by the "tool" joint in the official FR3WMS.urdf but never defined there -->
  <link name="tool_Link"/>
  <!-- ===================== DH-Robotics AG-105-145 gripper ===================== -->
  <!-- Mounted on the FR3 WMS tool flange face (0.100 m along wrist3_Link z).
       Change the last rpy value (yaw) if the gripper is clocked differently on your flange. -->
  <joint name="ag145_mount_joint" type="fixed">
    <parent link="wrist3_Link"/>
    <child link="gripper_base_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>
